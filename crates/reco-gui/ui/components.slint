import { Slider } from "std-widgets.slint";

/// Shared application colours. Native inputs follow Palette.color-scheme.
export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg-base: dark ? #11171c : #f3f5f6;
    out property <color> bg-panel: dark ? #192127 : #ffffff;
    out property <color> bg-surface: dark ? #202a32 : #ffffff;
    out property <color> bg-card: dark ? #242e36 : #edf1f3;
    out property <color> bg-hover: dark ? #303e48 : #e0e7eb;
    out property <color> bg-preview: #090d10;
    out property <color> bg-scrim: #000000a0;
    out property <color> border-mid: dark ? #536573 : #a4b3bd;
    out property <color> text-primary: dark ? #edf3f5 : #17252e;
    out property <color> text-body: dark ? #d3dfe5 : #253943;
    out property <color> text-secondary: dark ? #b5c5cf : #455b67;
    out property <color> text-muted: dark ? #96aab6 : #536b79;
    out property <color> accent: dark ? #98dec4 : #146e56;
    out property <color> accent-foreground: dark ? #12392f : #ffffff;
    out property <color> accent-info: dark ? #91c5e8 : #226592;
    out property <color> accent-warn: dark ? #edc188 : #8e5b14;
    out property <color> accent-error: dark ? #ffa99f : #a32e25;
}

/// Quiet actions with explicit keyboard, focus and accessibility behavior.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> description: root.text;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    in property <bool> align-left: false;
    callback clicked();

    min-width: max(34px, label.preferred-width + 24px);
    min-height: 34px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    background: !root.enabled ? transparent : root.primary ? (touch.pressed ? Theme.accent.darker(12%) : touch.has-hover ? Theme.accent.brighter(8%) : Theme.accent) : touch.pressed || touch.has-hover ? Theme.bg-hover : root.selected || !root.quiet ? Theme.bg-card : transparent;
    border-width: focus.has-focus && root.enabled ? 2px : 0px;
    border-color: Theme.accent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    label := Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: !root.enabled ? Theme.text-muted : root.primary ? Theme.accent-foreground : Theme.text-primary;
        font-size: 13px;
        font-weight: root.primary || root.selected ? 600 : 400;
        horizontal-alignment: root.align-left ? left : center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

/// One labeled slider row for the controls panel.
export component LabeledSlider inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <string> suffix: "";
    in property <int> decimals: 2;
    callback changed(float);

    spacing: 2px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            property <float> scale:
                root.decimals <= 0 ? 1 : root.decimals == 1 ? 10 : root.decimals == 2 ? 100 : root.decimals == 3 ? 1000 : root.decimals == 4 ? 10000 : 100000;
            text: (root.decimals == 0 ? round(root.value) : round(root.value * scale) / scale) + root.suffix;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    Slider {
        accessible-label: root.label;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        changed(v) => {
            root.changed(v);
        }
    }
}

/// Keyboard-accessible disclosure for secondary inspector controls.
export component SectionHeader inherits Button {
    in property <string> title;
    in-out property <bool> expanded: false;
    text: (root.expanded ? "▾  " : "▸  ") + root.title;
    quiet: true;
    align-left: true;
    horizontal-stretch: 1;
    clicked => {
        root.expanded = !root.expanded;
    }
}

// Toast notification payload. Kept flat (no nested structs) so the
// Rust side can push via the generated `VecModel<Toast>` without
// wrapping ceremony. `id` is an opaque Rust-side counter used as the
// dismissal handle; UI code doesn't interpret it.
export struct Toast {
    id: int,
    severity: string, // "info" | "warn" | "error"
    title: string,
    body: string,
}

/// Dismissible notification with a severity accent and shared theme.
component ToastCard inherits Rectangle {
    in property <Toast> toast;
    callback dismissed(int);

    height: content.preferred-height + 16px;
    width: 360px;
    border-radius: 6px;
    background: Theme.bg-surface;
    border-width: 0;
    drop-shadow-blur: 6px;
    drop-shadow-color: #000000aa;

    Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: parent.height;
        background: root.toast.severity == "error" ? Theme.accent-error : root.toast.severity == "warn" ? Theme.accent-warn : Theme.accent-info;
    }

    content := HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.toast.title;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                wrap: word-wrap;
            }

            if root.toast.body != "": Text {
                text: root.toast.body;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Button {
            text: "×";
            description: "Dismiss " + root.toast.title;
            quiet: true;
            clicked => {
                root.dismissed(root.toast.id);
            }
        }
    }
}

/// Bottom-right stack of toast cards. Spawns a `ToastCard` per entry
/// in `toasts` and forwards dismissal back to the consumer via the
/// `dismissed(id)` callback.
export component ToastStack inherits Rectangle {
    in property <[Toast]> toasts;
    in property <length> right-inset: 0px;
    callback dismissed(int);

    width: 100%;
    height: 100%;

    VerticalLayout {
        x: parent.width - self.preferred-width - 16px - root.right-inset;
        y: parent.height - self.preferred-height - 16px;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 8px;
        alignment: end;

        for toast in root.toasts: ToastCard {
            toast: toast;
            dismissed(id) => {
                root.dismissed(id);
            }
        }
    }
}

// Per-side video segment list with drag-to-reorder (grip handle) and
// per-row removal. Rows are a fixed height so pointer travel maps cleanly
// to row offsets; the dragged row dims and the destination row is outlined
// to preview where the segment will land.
export component SegmentList inherits Rectangle {
    in property <[string]> segments;
    in property <bool> enabled: true;
    callback remove(int);
    callback reorder(int /* from */, int /* to */);

    property <int> drag-from: -1; // row being dragged, or -1 when idle
    property <int> drag-to: -1; // insertion gap [0..count] under the cursor
    property <length> row-h: 34px;
    property <length> row-gap: 4px;
    property <length> rowstep: root.row-h + root.row-gap;
    property <int> count: root.segments.length;
    changed enabled => {
        if !root.enabled {
            root.drag-from = -1;
            root.drag-to = -1;
        }
    }

    height: root.count > 0 ? root.count * root.rowstep - root.row-gap : 0px;

    VerticalLayout {
        spacing: root.row-gap;
        for seg[idx] in root.segments: Rectangle {
            height: root.row-h;
            border-radius: 4px;
            background: Theme.bg-card;
            // The dragged row dims to a "ghost"; the drop position is shown
            // by the insertion line below, not a per-row outline.
            opacity: root.drag-from == idx ? 0.4 : 1.0;
            HorizontalLayout {
                padding-left: 2px;
                padding-right: 4px;
                spacing: 4px;
                // Drag handle. Only active with 2+ segments to reorder.
                Rectangle {
                    width: 18px;
                    Text {
                        text: "⠿";
                        color: grip.has-hover || root.drag-from == idx ? Theme.accent : Theme.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    grip := TouchArea {
                        enabled: root.enabled && root.count > 1;
                        mouse-cursor: grab;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.drag-from = idx;
                                root.drag-to = idx;
                            }
                            if (e.kind == PointerEventKind.up) {
                                // drag-to is an insertion gap [0..count]. Dropping
                                // in either gap touching the source is a no-op;
                                // otherwise map the gap to a row index, adjusting
                                // for the source being removed first.
                                if (root.drag-from != -1 && root.drag-to != root.drag-from && root.drag-to != root.drag-from + 1) {
                                    root.reorder(
                                        root.drag-from,
                                        root.drag-to > root.drag-from ? root.drag-to - 1 : root.drag-to);
                                }
                                root.drag-from = -1;
                                root.drag-to = -1;
                            }
                            if (e.kind == PointerEventKind.cancel) {
                                root.drag-from = -1;
                                root.drag-to = -1;
                            }
                        }
                        moved => {
                            if (root.drag-from == idx) {
                                // Nearest insertion gap to the cursor, in list
                                // coordinates (the grabbed grip reports mouse-y
                                // relative to its own row even past its bounds).
                                root.drag-to = Math.max(0, Math.min(root.count,
                                    Math.round((idx * root.rowstep + self.mouse-y) / root.rowstep)));
                            }
                        }
                    }
                }

                Text {
                    text: (idx + 1) + ". " + seg;
                    color: Theme.text-body;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "×";
                    description: "Remove " + seg;
                    quiet: true;
                    enabled: root.enabled;
                    clicked => {
                        root.remove(idx);
                    }
                }
            }
        }
    }

    // Insertion line: during a drag, drawn in the gap where the segment will
    // land - a thin accent bar with a dot on the leading edge. Hidden when the
    // target gap touches the dragged row (those drops are no-ops).
    if root.drag-from != -1 && root.drag-to != root.drag-from && root.drag-to != root.drag-from + 1: Rectangle {
        x: 0;
        y: max(0px, min(root.height - 2px, root.drag-to * root.rowstep - root.row-gap / 2));
        width: root.width;
        height: 2px;
        background: Theme.accent;
        border-radius: 1px;
        Rectangle {
            x: 0px;
            y: -2px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
        }
    }
}
