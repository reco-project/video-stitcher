// Preview-first desktop workspace. Native input widgets follow the application theme.

import {
    VerticalBox,
    HorizontalBox,
    Slider,
    ProgressIndicator,
    LineEdit,
    ComboBox,
    CheckBox,
    ScrollView,
    Palette,
} from "std-widgets.slint";
import {
    Button,
    LabeledSlider,
    SectionHeader,
    Toast,
    ToastStack,
    SegmentList,
    Theme,
} from "components.slint";
export { Toast }

export struct NetworkInputRow { url: string, offset: string }

export component RecoApp inherits Window {
    title: "Reco Video Stitcher";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 600px;

    // ── Theme colors ──
    in-out property <bool> dark-mode: true;

    // The native picker has no parent; keep workspace input blocked until its worker returns or disconnects.
    in-out property <bool> file-dialog-open: false;

    background: Theme.bg-base;
    default-font-size: 13px;
    changed dark-mode => {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    // Preview area dimensions (Rust reads these to size the render target).
    out property <float> preview-area-width: preview-box.width / 1px;
    out property <float> preview-area-height: preview-box.height / 1px;

    // ── Properties bound from Rust ──

    in-out property <image> preview-frame;
    in-out property <bool> playing: false;
    in-out property <bool> files-loaded: false;
    in-out property <bool> network-active: false;
    in-out property <bool> network-opening: false;
    in-out property <bool> network-dialog-open: false;
    in-out property <[NetworkInputRow]> network-inputs;
    in-out property <string> network-fps: "30";
    in-out property <string> network-message;
    in-out property <string> left-path: "";
    in-out property <string> right-path: "";
    in-out property <bool> is-l-shape: true;
    in-out property <string> calibration-path: "";
    in-out property <string> status-text: "Open video files or connect live cameras to begin";
    in-out property <float> progress: 0.0;
    in-out property <int> current-frame: 0;
    in-out property <int> total-frames: 0;
    in-out property <string> current-time-text: "0:00";
    in-out property <string> total-time-text: "0:00";
    in-out property <float> fps: 0.0;
    in-out property <bool> calibrating: false;
    in-out property <bool> calibration-needs-review: false;
    in-out property <bool> fix-left-optics: false;
    in-out property <bool> fix-right-optics: false;
    in-out property <string> calibration-offset-input;
    changed left-path => { root.fix-left-optics = false; root.calibration-offset-input = ""; }
    changed right-path => { root.fix-right-optics = false; root.calibration-offset-input = ""; }
    in-out property <string> calibration-step: "";
    out property <bool> has-both-videos: left-path != "" && right-path != "";
    in-out property <bool> has-roi: false;
    in-out property <[float]> roi-points-x: [];
    in-out property <[float]> roi-points-y: [];
    in-out property <bool> field-editing: false;
    in-out property <bool> field-can-apply: false;
    in-out property <int> field-corner-count: 0;
    in-out property <string> field-message;
    in-out property <string> field-outline;
    callback edit-field();
    callback place-field-corner(int, float, float);
    callback hit-field-corner(float, float, float, float) -> int;
    callback finish-field(bool);
    callback reset-field-draft();
    callback remove-field();

    // Camera view state (kept in sync with Rust AppState).
    in-out property <float> yaw: 0.0;      // radians
    in-out property <float> pitch: 0.0;    // radians
    in-out property <float> fov: 75.0;     // degrees
    in-out property <float> blend-width: 0.05;
    in-out property <float> rig-tilt: 0.0; // degrees
    in-out property <float> rig-roll: 0.0; // degrees
    in-out property <int> sync-offset: 0;  // frames

    // Live projection geometry adjustments.
    // Edits update the calibration document and its derived preview.
    in-out property <float> cal-intersect: 0.0;
    in-out property <float> cal-camera-axis-offset: 0.0;
    in-out property <float> cal-x-ty: 0.0;
    in-out property <bool> cal-dirty: false;  // true when user has edited


    // Export dialog state.
    in-out property <bool> export-dialog-open: false;
    in-out property <string> export-output-path: "";
    in-out property <bool> export-stream-enabled: false;
    in-out property <string> export-stream-url: "";
    in-out property <string> export-stream-status: "";
    in-out property <bool> export-stream-failed: false;
    in-out property <[string]> export-audio-options: ["No source audio", "Camera 1"];
    in-out property <int> export-audio-choice: 1;
    in-out property <int> export-width: 1920;
    in-out property <int> export-height: 1080;
    in-out property <string> export-codec: "h264";
    in-out property <[string]> available-codecs: ["h264", "hevc", "av1"];
    in-out property <string> export-quality: "balanced";
    in-out property <float> export-blend-width: 0.05;
    in-out property <float> export-start-secs: 0.0;
    in-out property <float> export-end-secs: 0.0;
    in-out property <float> clip-duration-secs: 0.0;
    in-out property <string> export-model-path: "";
    in-out property <string> export-tracking-mode: "field";
    in-out property <int> export-detection-interval: 3;
    in-out property <bool> export-autocam-enabled: false;
    // Panner tuning mapped onto FieldPannerConfig in export.rs.
    in-out property <string> export-panner-preset: "broadcast";
    in-out property <float> export-lookahead-secs: 1.5;
    in-out property <string> export-framing: "action";
    in-out property <bool> export-lock-pitch: false;
    in-out property <string> export-cluster-mode: "density";
    in-out property <float> export-cluster-bandwidth: 0.30;
    in-out property <float> export-dead-zone: 0.20;
    in-out property <float> export-ball-weight: 0.20;
    in-out property <float> export-fov-tight: 22.0;
    in-out property <float> export-fov-wide: 58.0;
    in-out property <float> export-frame-all-margin: 5.0;
    in-out property <float> export-fov-default: 40.0;

    changed export-framing => {
        if (self.export-framing != "frame_all") {
            self.export-fov-tight = self.export-fov-tight.clamp(10.0, 40.0);
            self.export-fov-wide = self.export-fov-wide.clamp(40.0, 90.0);
        }
    }
    in-out property <bool> export-replay-enabled: false;
    in-out property <bool> export-events-enabled: false;

    // Export progress (also used by the main status bar).
    in-out property <bool> export-in-progress: false;
    in-out property <float> export-progress: 0.0; // 0..1
    in-out property <int> export-frames-done: 0;
    in-out property <int> export-frames-total: 0;
    in-out property <string> export-status-text: "";
    in-out property <string> export-error-text: "";

    // Compile-time AI capability summary. Seeded by Rust at startup
    // so the user can tell at-a-glance whether ball tracking will
    // actually work with their build (TensorRT, CUDA, CoreML, etc).
    in-out property <string> ai-status: "AI: unknown";
    in-out property <bool> ai-available: false;

    in-out property <string> version: "";
    in-out property <string> last-output-path: "";

    // Lens information from the latest fit or manual selection.
    in-out property <string> lens-left-camera: "";
    in-out property <string> lens-left-lens: "";
    in-out property <string> lens-left-source: "";
    in-out property <string> lens-right-camera: "";
    in-out property <string> lens-right-lens: "";
    in-out property <string> lens-right-source: "";
    in-out property <bool> lens-info-available: false;

    in-out property <int> calibration-frames: 4;
    in-out property <float> cal-skip-end-secs: 0.0;

    // When true (default), pan/zoom is clamped to the coverage boundary
    // so the viewport never shows black margins. Users can disable it
    // to inspect what is happening beyond the stitched region, which is
    // useful for calibration debug.
    in-out property <bool> use-constrained-look: true;

    // Recent-files dialog state.
    in-out property <bool> recent-dialog-open: false;
    in-out property <[string]> recent-left-paths: [];
    in-out property <[string]> recent-right-paths: [];
    in-out property <[string]> recent-calibration-paths: [];

    // Keyboard shortcut help modal.
    in-out property <bool> shortcuts-dialog-open: false;

    // Preferences dialog state.
    in-out property <bool> prefs-dialog-open: false;
    in-out property <string> prefs-default-codec: "h264";
    in-out property <string> prefs-default-quality: "balanced";
    in-out property <float> prefs-default-blend-width: 0.05;
    in-out property <string> prefs-ai-model-path: "";

    // Transient status and error notifications.
    in-out property <[Toast]> toasts: [];
    callback toast-dismissed(int);

    // Telemetry panel state.
    in-out property <float> telem-fps-avg: 0.0;
    in-out property <float> telem-fps-recent: 0.0;
    in-out property <float> telem-decode-ms: 0.0;
    in-out property <float> telem-stitch-ms: 0.0;
    in-out property <float> telem-readback-ms: 0.0;
    in-out property <float> telem-submit-ms: 0.0;
    in-out property <float> telem-total-ms: 0.0;
    in-out property <float> telem-p99-ms: 0.0;
    in-out property <float> telem-detection-ms: 0.0;
    in-out property <float> telem-tracking-ms: 0.0;
    in-out property <float> telem-encode-ms: 0.0;
    in-out property <float> telem-backpressure-ms: 0.0;
    in-out property <int> telem-active-tracks: 0;
    in-out property <float> telem-ball-pct: 0.0;
    in-out property <float> telem-det-per-frame: 0.0;
    in-out property <string> telem-gpu-name: "";

    // Per-camera lens intrinsics (populated by Rust after auto-calibrate
    // from `CalibrationResult.left_lens_profile` / `right_lens_profile`).
    // The Lens tab binds sliders to these properties; changes flow back
    // to Rust via `changed-lens-param` for validated live preview updates.
    in-out property <float> lens-left-fx: 0.0;
    in-out property <float> lens-left-fy: 0.0;
    in-out property <float> lens-left-cx: 0.0;
    in-out property <float> lens-left-cy: 0.0;
    in-out property <float> lens-left-k1: 0.0;
    in-out property <float> lens-left-k2: 0.0;
    in-out property <float> lens-left-k3: 0.0;
    in-out property <float> lens-left-k4: 0.0;
    in-out property <float> lens-right-fx: 0.0;
    in-out property <float> lens-right-fy: 0.0;
    in-out property <float> lens-right-cx: 0.0;
    in-out property <float> lens-right-cy: 0.0;
    in-out property <float> lens-right-k1: 0.0;
    in-out property <float> lens-right-k2: 0.0;
    in-out property <float> lens-right-k3: 0.0;
    in-out property <float> lens-right-k4: 0.0;
    // Slider display ranges (set by Rust to baseline +/- safe delta).
    in-out property <float> lens-fx-min: 0.0;
    in-out property <float> lens-fx-max: 0.0;
    in-out property <float> lens-fy-min: 0.0;
    in-out property <float> lens-fy-max: 0.0;
    in-out property <float> lens-cx-min: 0.0;
    in-out property <float> lens-cx-max: 0.0;
    in-out property <float> lens-cy-min: 0.0;
    in-out property <float> lens-cy-max: 0.0;
    in-out property <float> lens-k-range: 0.3; // k sliders: baseline +/- this
    in-out property <bool> lens-dirty: false;
    // Which camera the lens-tab sliders are editing.
    in-out property <string> lens-selected-camera: "left";

    // ── Callbacks into Rust ──

    callback pick-left-video();
    callback open-network();
    callback connect-network();
    callback cancel-network();
    callback disconnect-network();
    callback pick-right-video();
    callback pick-calibration();
    callback auto-calibrate();
    callback cancel-calibration();
    callback review-calibration();
    callback toggle-playback();
    callback step-forward();
    callback step-backward();
    callback seek-frame(int);
    // Relative seek in seconds (negative for rewind). CLI parity with `[` and `]`.
    callback seek-relative(float);
    // Mouse drag delta in pixels.
    callback pan(float, float);
    // Scroll wheel delta (degrees FOV per tick).
    callback zoom(float);
    // Reset yaw/pitch/fov to defaults.
    callback reset-view();
    // Settings-panel slider callbacks.
    callback changed-blend-width(float);
    callback changed-rig-tilt(float);
    callback changed-rig-roll(float);
    callback changed-sync-offset(int);
    callback changed-fov(float);
    // Live calibration editing.
    callback changed-cal-intersect(float);
    callback changed-cal-camera-axis-offset(float);
    callback changed-cal-x-ty(float);
    callback save-calibration();
    callback reset-calibration();
    // Live lens parameter editing. Fires on any of the 8 sliders per
    // camera; Rust reads the property values for the currently-selected
    // camera and submits an edited calibration.
    callback changed-lens-param();
    callback reset-lens();

    // Lens picker dialog.
    callback lens-search-changed(string);
    callback lens-pick(int, string);
    callback lens-pick-file();
    in-out property <bool> lens-picker-open: false;
    in-out property <string> lens-search-query: "";
    in-out property <[string]> lens-search-results: [];
    in-out property <string> lens-pick-side: "both";

    // Lens preview mode (single-camera flat view).
    in-out property <bool> lens-preview-active: false;
    in-out property <string> lens-preview-side: "left";
    in-out property <float> lens-correction-amount: 1.0;
    callback changed-lens-preview();
    callback changed-lens-correction(float);

    // Constrained-look checkbox. Fires when the user toggles it so Rust
    // can sync `AppState.use_constrained_look` with the UI property
    // (Slint's <=> binding updates the property but Rust needs a notify
    // to act on the new value).
    callback changed-constrained-look();
    // Recent-files modal: load a specific path into one of the three
    // file slots. Same effect as picking it from the native dialog.
    callback load-recent-left(string);
    callback load-recent-right(string);
    callback load-recent-calibration(string);
    callback clear-recent-files();
    // Preferences dialog: open prefills from user_settings, save
    // writes back (Rust handles persistence), pick-model opens a
    // file dialog for the AI model path.
    callback open-prefs-dialog();
    callback save-prefs();
    callback pick-prefs-model();
    callback open-website();
    callback open-forum();
    in-out property <bool> prefs-telemetry-enabled: false;
    in-out property <bool> prefs-dark-mode: true;
    // Export dialog actions.
    callback open-export-dialog();
    callback pick-export-output();
    callback pick-export-model();
    callback start-export();
    // Populate the visible panner controls from a named preset.
    callback apply-panner-preset(string);
    callback cancel-export();
    callback submit-bug-report(string, string, bool);
    in-out property <bool> bug-dialog-open: false;
    in-out property <string> bug-user-contact: "";
    callback show-in-folder(string);
    callback toggle-recording(string, string);
    callback pick-recording-folder();
    in-out property <bool> recording: false;
    in-out property <string> recording-quality: "balanced";
    in-out property <string> recording-codec: "h264";
    in-out property <string> prefs-recording-codec: "h264";
    in-out property <string> prefs-recording-quality: "balanced";
    in-out property <string> prefs-recording-folder: "";

    // Preview aspect ratio mode: "auto" fills the available space
    // preserving the source aspect; ratio values constrain the
    // preview container to that shape.
    in-out property <string> preview-aspect: "auto";
    callback changed-preview-aspect(string);

    // File management: per-side segment lists and removal.
    in-out property <[string]> left-segments: [];
    in-out property <[string]> right-segments: [];
    callback remove-left-segment(int);
    callback remove-right-segment(int);
    callback reorder-left-segment(int /* from */, int /* to */);
    callback reorder-right-segment(int /* from */, int /* to */);
    callback clear-left();
    callback clear-right();
    callback clear-calibration();

    // A single inspector keeps setup and adjustments beside the preview.
    in-out property <bool> inspector-open: true;
    in-out property <int> inspector-tab: 0;
    property <length> inspector-width: 320px;
    property <bool> setup-locked: root.export-in-progress || root.recording || root.calibrating || root.field-editing || root.network-opening;
    changed files-loaded => {
        if !root.files-loaded {
            root.inspector-tab = 0;
            root.inspector-open = true;
            root.playing = false;
            root.current-frame = 0;
            root.total-frames = 0;
            root.current-time-text = "0:00";
            root.total-time-text = "0:00";
        }
    }
    property <bool> overlay-open: root.recent-dialog-open || root.shortcuts-dialog-open || root.prefs-dialog-open || root.bug-dialog-open || root.export-dialog-open || root.lens-picker-open || root.network-dialog-open;
    property <bool> modal-open: root.overlay-open || root.file-dialog-open;
    changed modal-open => {
        if root.modal-open {
            modal.show();
        } else {
            modal.close();
        }
    }
    function dismiss-dialogs() {
        if root.network-opening { root.cancel-network(); } else { root.network-dialog-open = false; }
        root.recent-dialog-open = false;
        root.shortcuts-dialog-open = false;
        root.prefs-dialog-open = false;
        root.bug-dialog-open = false;
        root.export-dialog-open = false;
        root.lens-picker-open = false;
    }

    // Keyboard handling. The FocusScope must *wrap* the content so
    // key events have somewhere to bubble up when a child (button,
    // slider, text input) is focused. `init` grabs focus on startup
    // so shortcuts work before the user clicks anything. The
    // `refocus` callback lets Rust re-assert focus after any action
    // that a widget would otherwise steal it with.
    forward-focus: key-scope;
    public function refocus() {
        key-scope.focus();
    }

    key-scope := FocusScope {
        // FocusScope doesn't fill its Window parent by default; the
        // VerticalBox below would render at its preferred height and
        // overflow the bottom of the window, hiding the transport
        // controls and status bar. Explicit 100/100 fixes that.
        width: 100%;
        height: 100%;
        init => {
            self.focus();
            Theme.dark = root.dark-mode;
            Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        }
        key-pressed(event) => {
            if root.file-dialog-open {
                return reject;
            }
            if root.overlay-open {
                if event.text == Key.Escape {
                    root.dismiss-dialogs();
                    root.refocus();
                    return accept;
                }
                return reject;
            }
            if (event.text == "f" || event.text == "F" || event.text == Key.F11) {
                root.full-screen = !root.full-screen;
                return accept;
            }
            if !root.files-loaded || root.export-in-progress {
                return reject;
            }
            if root.field-editing && event.text == Key.Escape { root.finish-field(false); return accept; }
            // Source playback remains available in either preview mode.
            if (event.text == " ") {
                root.toggle-playback();
                return accept;
            }
            if (event.text == "[") {
                root.seek-relative(-5);
                return accept;
            }
            if (event.text == "]") {
                root.seek-relative(5);
                return accept;
            }
            if root.lens-preview-active {
                return reject;
            }
            // Arrow keys: pan
            if (event.text == Key.LeftArrow) {
                root.pan(-20, 0);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.pan(20, 0);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pan(0, -20);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pan(0, 20);
                return accept;
            }
            // +/- : zoom
            if (event.text == "+" || event.text == "=") {
                root.zoom(-5);
                return accept;
            }
            if (event.text == "-" || event.text == "_") {
                root.zoom(5);
                return accept;
            }
            // R : reset view
            if (event.text == "r" || event.text == "R") {
                root.reset-view();
                return accept;
            }
            return reject;
        }

        // VerticalLayout (not VerticalBox) because VerticalBox applies
        // implicit outer padding that pushed the bottom transport/status
        // bars off the content area. Explicit layout with zero spacing
        // ensures the file-bar + preview + transport + status fit the
        // window exactly, no inset on any edge.
        VerticalLayout {
            spacing: 0;

            // Workspace actions remain visible while the inspector scrolls.
        Rectangle {
                background: Theme.bg-base;
                height: 62px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;
                    Text {
                        text: "reco";
                        color: Theme.text-primary;
                        font-size: 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "VIDEO STITCHER";
                        visible: root.width > 1000px;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.calibrating: Text {
                        text: root.calibration-step;
                        color: Theme.accent-info;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 240px;
                    }
                    if root.cal-dirty || root.lens-dirty: Button {
                        text: "Save calibration";
                        enabled: !root.field-editing && !root.calibrating;
                        clicked => {
                            root.save-calibration();
                        }
                    }
                    Button {
                        text: "Workspace";
                        quiet: true;
                        selected: root.inspector-open;
                        clicked => {
                            root.inspector-open = !root.inspector-open;
                        }
                    }

                    Button {
                        text: "Help";
                        quiet: true;
                        clicked => {
                            root.shortcuts-dialog-open = true;
                        }
                    }

                    Button {
                        text: "Settings";
                        quiet: true;
                        clicked => {
                            root.open-prefs-dialog();
                        }
                    }

                    Button {
                        text: root.network-active ? "Record / publish…" : "Export…";
                        description: root.recording ? "Stop quick recording before exporting" : root.network-active ? "Record the processed live feed, with optional streaming" : "Export a stitched video";
                        primary: true;
                        enabled: root.files-loaded && !root.export-in-progress && !root.recording && !root.calibrating && !root.field-editing;
                        clicked => {
                            root.open-export-dialog();
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                vertical-stretch: 1;
            // Preview (with mouse drag + scroll handling).
            // The outer Rectangle fills the layout cell; the inner
            // `preview-box` optionally constrains itself to a chosen
            // aspect ratio and centers inside the outer area.
            Rectangle {
                    background: Theme.bg-preview;
                    horizontal-stretch: 1;

                    border-radius: 12px;

                    if !root.files-loaded: VerticalLayout {
                        property <bool> can-calibrate: root.has-both-videos && root.is-l-shape;
                        padding: 32px;
                        alignment: center;
                        spacing: 16px;
                        Text {
                            text: root.calibrating ? "Aligning your cameras" : root.network-active ? "Live preview is stopped" : parent.can-calibrate ? "Align your cameras" : root.left-path != "" && root.is-l-shape ? "Add the right camera" : "Your cameras.\nOne view.";
                            color: #edf3f5;
                            font-size: root.width > 1000px ? 34px : 26px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.calibrating ? root.calibration-step : root.network-active ? "Reconnect the selected RTSP cameras to preview again." : parent.can-calibrate ? "Auto-calibrate these videos or load a saved calibration." : root.left-path != "" && root.is-l-shape ? "Then align the two views or load a saved calibration.\nFor a single panorama, load its cylindrical calibration." : "Open video files, or connect live cameras\nusing a saved rig calibration.";
                            color: #a6b8c4;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            Button {
                                text: root.calibrating ? "Cancel calibration" : root.network-active ? "Reconnect…" : root.has-both-videos && root.is-l-shape ? "Auto-calibrate" : root.left-path != "" && root.is-l-shape ? "Add right video" : "Open video…";
                                primary: true;
                                enabled: root.calibrating ? root.calibration-step != "Stopping…" : !root.setup-locked;
                                clicked => {
                                    if root.calibrating { root.cancel-calibration(); }
                                    else if root.network-active { root.open-network(); }
                                    else if root.has-both-videos && root.is-l-shape { root.auto-calibrate(); }
                                    else if root.left-path != "" && root.is-l-shape { root.pick-right-video(); }
                                    else { root.pick-left-video(); }
                                }
                            }

                            Button {
                                text: root.left-path != "" || root.right-path != "" || root.network-active ? "Load calibration…" : "Connect live…";
                                enabled: !root.setup-locked;
                                clicked => {
                                    if root.left-path != "" || root.right-path != "" || root.network-active { root.pick-calibration(); }
                                    else { root.open-network(); }
                                }
                            }
                        }
                    }

                    // Aspect-constrained preview container. When "auto"
                // (default) it fills the parent; when a ratio is
                // chosen it shrinks one axis to maintain that ratio,
                // centered within the outer Rectangle.
                preview-box := Rectangle {
                        property <float> ratio:
                        root.preview-aspect == "16:9" ? (16.0 / 9.0) : root.preview-aspect == "4:3" ? (4.0 / 3.0) : root.preview-aspect == "21:9" ? (21.0 / 9.0) : 0;

                        property <length> fit-w:
                        ratio > 0 ? min(parent.width, parent.height * ratio / 1.0) : parent.width;
                        property <length> fit-h:
                        ratio > 0 ? min(parent.height, parent.width / ratio * 1.0) : parent.height;

                        width: fit-w;
                        height: fit-h;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        property <float> image-aspect: root.preview-frame.height > 0 ? root.preview-frame.width / root.preview-frame.height : 1;
                        property <length> image-width: min(self.width, self.height * image-aspect);
                        property <length> image-height: image-width / image-aspect;
                        property <length> image-left: (self.width - image-width) / 2;
                        property <length> image-top: (self.height - image-height) / 2;

                        if root.files-loaded: Image {
                            source: root.preview-frame;
                            image-fit: contain;
                            width: 100%;
                            height: 100%;
                        }

                        // Preview is released during export to free VRAM; show
                    // that it is intentionally paused, not frozen/broken.
                    if root.files-loaded && root.export-in-progress: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: #000000bb;
                            Text {
                                text: root.network-active ? "Preview paused while recording / publishing" : "Preview paused during export";
                                color: #dddddd;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.field-editing: Path {
                            x: preview-box.image-left;
                            y: preview-box.image-top;
                            width: preview-box.image-width;
                            height: preview-box.image-height;
                            viewbox-width: root.preview-frame.width;
                            viewbox-height: root.preview-frame.height;
                            commands: root.field-outline;
                            fill: #22ff6630;
                            stroke: #22ff66;
                            stroke-width: 2px;
                        }
                        for idx in root.roi-points-x.length: Rectangle {
                            visible: root.field-editing && root.roi-points-x[idx] >= 0 && root.roi-points-x[idx] <= 1 && root.roi-points-y[idx] >= 0 && root.roi-points-y[idx] <= 1;
                            x: preview-box.image-left + root.roi-points-x[idx] * preview-box.image-width - 10px;
                            y: preview-box.image-top + root.roi-points-y[idx] * preview-box.image-height - 10px;
                            width: 20px; height: 20px;
                            border-radius: 10px;
                            background: #22ff66;
                            Text { text: idx + 1; color: #112218; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    drag := TouchArea {
                        enabled: root.files-loaded && !root.export-in-progress && !root.lens-preview-active;
                        mouse-cursor: root.field-editing ? crosshair : self.pressed ? grabbing : grab;
                        property <length> last-x: 0px;
                        property <length> last-y: 0px;
                        property <int> corner: -1;
                        property <bool> dragged: false;
                        property <float> image-x: (self.mouse-x - preview-box.x - preview-box.image-left) / max(1px, preview-box.image-width);
                        property <float> image-y: (self.mouse-y - preview-box.y - preview-box.image-top) / max(1px, preview-box.image-height);
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                self.last-x = self.mouse-x;
                                self.last-y = self.mouse-y;
                                self.dragged = false;
                                self.corner = root.field-editing ? root.hit-field-corner(self.image-x, self.image-y, preview-box.image-width / 1px, preview-box.image-height / 1px) : -1;
                            }
                            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                                if root.field-editing && !self.dragged && self.corner < 0 {
                                    root.place-field-corner(-1, self.image-x, self.image-y);
                                }
                                self.corner = -1;
                            }
                            if e.kind == PointerEventKind.cancel { self.corner = -1; self.dragged = true; }
                        }
                        moved => {
                            if self.pressed {
                                if abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px { self.dragged = true; }
                                if root.field-editing && self.corner >= 0 {
                                    root.place-field-corner(self.corner, self.image-x, self.image-y);
                                } else if !root.field-editing || self.dragged {
                                    root.pan((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                }
                                self.last-x = self.mouse-x;
                                self.last-y = self.mouse-y;
                            }
                        }
                        scroll-event(e) => { root.zoom(-e.delta-y / 40px); return accept; }
                    }

                    if root.files-loaded && root.lens-preview-active && !root.export-in-progress: Rectangle {
                        x: 12px;
                        y: 12px;
                        width: min(parent.width - 24px, 280px);
                        height: 42px;
                        background: Theme.bg-panel;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            Button {
                                text: "Panorama";
                                quiet: true;
                                clicked => {
                                    root.lens-preview-active = false;
                                    root.changed-lens-preview();
                                }
                            }

                            Button {
                                text: "Left";
                                selected: root.lens-preview-side == "left";
                                quiet: true;
                                clicked => {
                                    root.lens-preview-side = "left";
                                    root.changed-lens-preview();
                                }
                            }

                            Button {
                                text: "Right";
                                selected: root.lens-preview-side == "right";
                                quiet: true;
                                clicked => {
                                    root.lens-preview-side = "right";
                                    root.changed-lens-preview();
                                }
                            }
                        }
                    }
                }

                if root.inspector-open: Rectangle {
                    background: Theme.bg-panel;
                    border-radius: 12px;
                    width: root.inspector-width;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 34px;
                            spacing: 6px;
                            Button {
                                text: "Setup";
                                selected: root.inspector-tab == 0;
                                quiet: true;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.inspector-tab = 0;
                                }
                            }

                            Button {
                                text: "Adjust";
                                selected: root.inspector-tab == 1;
                                quiet: true;
                                enabled: root.files-loaded && !root.field-editing;
                                horizontal-stretch: 1;
                                clicked => {
                                    root.inspector-tab = 1;
                                }
                            }
                        }

                        if root.field-editing: VerticalLayout {
                            vertical-stretch: 1;
                            padding: 8px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "Field corners · " + root.field-corner-count + "/4"; color: Theme.text-primary; font-size: 14px; font-weight: 600; }
                            Text { text: root.field-message; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 6px;
                                Button { text: "Apply corners"; primary: true; enabled: root.field-can-apply; clicked => { root.finish-field(true); } }
                                Button { text: "Cancel"; clicked => { root.finish-field(false); } }
                                Button { text: "Reset"; enabled: root.field-corner-count > 0; clicked => { root.reset-field-draft(); } }
                            }
                            Text { text: "Apply updates the tracking region. Save calibration to keep it for next time."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                        }
                        if root.inspector-tab == 0 && !root.field-editing: ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 12px;
                                alignment: start;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Sources"; color: Theme.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button {
                                        text: root.network-active ? "RTSP inputs…" : "Connect live…";
                                        enabled: !root.setup-locked;
                                        clicked => { root.open-network(); }
                                    }
                                }
                                if root.network-active: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: root.network-inputs.length + (root.network-inputs.length == 1 ? " live camera" : " live cameras") + " · RTSP"; color: Theme.text-secondary; font-size: 12px; }
                                    Text { text: root.files-loaded ? "Preview connected. Record / publish starts a separate processed output." : "Preview stopped. Reconnect to continue."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "Open files…"; enabled: !root.setup-locked; clicked => { root.pick-left-video(); } }
                                        Button { text: "Disconnect"; enabled: !root.setup-locked; clicked => { root.disconnect-network(); } }
                                    }
                                }

                        if !root.network-active: VerticalLayout {
                            spacing: 10px;
                            source-details := SectionHeader {
                                title: root.is-l-shape ? "Video files · two cameras" : "Video file · panorama";
                                expanded: !root.files-loaded;
                            }
                            if source-details.expanded: VerticalLayout {
                                spacing: 10px;

                        // Left video section
                        HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.is-l-shape ? "Left camera" : "Panorama";
                                        color: Theme.accent;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Add";
                                        enabled: !root.setup-locked;
                                        clicked => {
                                            root.pick-left-video();
                                        }
                                    }

                                    Button {
                                        text: "Clear";
                                        enabled: root.left-path != "" && !root.setup-locked;
                                        clicked => {
                                            root.clear-left();
                                        }
                                    }
                                }

                                if root.left-segments.length == 0: Text {
                                    text: "No video selected";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }

                                SegmentList {
                                    segments: root.left-segments;
                                    enabled: !root.setup-locked;
                                    remove(i) => {
                                        root.remove-left-segment(i);
                                    }
                                    reorder(f, t) => {
                                        root.reorder-left-segment(f, t);
                                    }
                                }

                                // Right video section
                        if root.is-l-shape: HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Right camera";
                                        color: Theme.accent;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Add";
                                        enabled: !root.setup-locked;
                                        clicked => {
                                            root.pick-right-video();
                                        }
                                    }

                                    Button {
                                        text: "Clear";
                                        enabled: root.right-path != "" && !root.setup-locked;
                                        clicked => {
                                            root.clear-right();
                                        }
                                    }
                                }

                                if root.is-l-shape && root.right-segments.length == 0: Text {
                                    text: "No video selected";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }

                                if root.is-l-shape: SegmentList {
                                    segments: root.right-segments;
                                    enabled: !root.setup-locked;
                                    remove(i) => {
                                        root.remove-right-segment(i);
                                    }
                                    reorder(f, t) => {
                                        root.reorder-right-segment(f, t);
                                    }
                                }
                                Button {
                                    text: "Recent files…";
                                    quiet: true;
                                    enabled: !root.setup-locked && (root.recent-left-paths.length > 0 || root.recent-right-paths.length > 0 || root.recent-calibration-paths.length > 0);
                                    clicked => { root.recent-dialog-open = true; }
                                }
                            }
                        }

                                Text {
                                    text: "Calibration";
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    if root.has-both-videos && root.is-l-shape: Button {
                                        text: root.calibrating ? (root.calibration-step == "Stopping…" ? "Stopping…" : "Cancel calibration") : (root.files-loaded ? "Re-calibrate" : "Auto Calibrate");
                                        enabled: !root.export-in-progress && !root.recording && (!root.calibrating || root.calibration-step != "Stopping…");
                                        horizontal-stretch: 1;
                                        clicked => {
                                            if root.calibrating {
                                                root.cancel-calibration();
                                            } else {
                                                root.auto-calibrate();
                                            }
                                        }
                                    }
                                    Button {
                                        text: "Load…";
                                        enabled: !root.setup-locked;
                                        clicked => {
                                            root.pick-calibration();
                                        }
                                    }
                                }

                                if root.calibration-path == "" && !root.files-loaded && !root.has-both-videos: Text {
                                    text: "Load a saved calibration, or add two videos to auto-calibrate. Live inputs need a saved calibration first.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                if root.has-both-videos && root.is-l-shape: VerticalLayout {
                                    spacing: 6px;

                                    LineEdit {
                                        text <=> root.calibration-offset-input;
                                        placeholder-text: "Sync offset in frames (blank for auto)";
                                        accessible-label: "Synchronization offset, right frame minus left frame";
                                        enabled: !root.setup-locked;
                                    }

                                    if root.calibration-needs-review: Button {
                                        text: "Preview candidate (not saved)";
                                        enabled: !root.export-in-progress && !root.recording && !root.calibrating;
                                        clicked => { root.review-calibration(); }
                                    }

                                    cal-advanced := SectionHeader {
                                        title: "Calibration options";
                                        expanded: false;
                                    }

                                    if cal-advanced.expanded: VerticalLayout {
                                        spacing: 4px;

                                        if root.calibration-path != "": CheckBox {
                                            text: "Keep current left lens fixed";
                                            checked <=> root.fix-left-optics;
                                            enabled: !root.calibrating;
                                        }

                                        if root.calibration-path != "": CheckBox {
                                            text: "Keep current right lens fixed";
                                            checked <=> root.fix-right-optics;
                                            enabled: !root.calibrating;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Frames:";
                                                color: Theme.text-muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }

                                            ComboBox {
                                                model: ["2", "4", "6", "8"];
                                                current-value: root.calibration-frames;
                                                width: 56px;
                                                enabled: !root.calibrating;
                                                selected(v) => {
                                                    root.calibration-frames = max(2, v.to-float());
                                                }
                                            }

                                        }




                                        LabeledSlider {
                                            label: "Skip end";
                                            minimum: 0;
                                            maximum: 60;
                                            value <=> root.cal-skip-end-secs;
                                            suffix: "s";
                                            decimals: 0;
                                            changed(v) => {
                                            }
                                        }
                                    }
                                }

                                if root.calibration-path != "": Rectangle {
                                    height: 34px;
                                    border-radius: 4px;
                                    background: Theme.bg-card;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        Text {
                                            text: root.calibration-path;
                                            color: Theme.text-body;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Button {
                                            text: "×";
                                            description: "Clear calibration";
                                            quiet: true;
                                            enabled: !root.setup-locked;
                                            clicked => {
                                                root.clear-calibration();
                                            }
                                        }
                                    }
                                }

                                if root.files-loaded: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Tracking region"; color: Theme.text-primary; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            text: root.has-roi ? "Edit four corners" : "Set four corners";
                                            enabled: !root.network-active && !root.setup-locked && !root.lens-preview-active;
                                            clicked => { root.edit-field(); }
                                        }
                                        if root.has-roi: Button {
                                            text: "Remove";
                                            enabled: !root.network-active && !root.setup-locked;
                                            clicked => { root.remove-field(); }
                                        }
                                    }
                                    Text { text: root.has-roi ? "Four corners are set. Tracking ignores action outside this region." : "Optional: mark four corners to keep tracking on the field."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                        if root.inspector-tab == 1 && root.files-loaded && !root.field-editing: ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 12px;
                                alignment: start;
                    // ── Camera (hidden during lens preview) ──
                    if !root.lens-preview-active: Text {
                                    text: "Camera";
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }

                                if !root.lens-preview-active: LabeledSlider {
                                    label: "Field of view";
                                    minimum: 1;
                                    maximum: 150;
                                    value <=> root.fov;
                                    suffix: "°";
                                    decimals: 0;
                                    changed(v) => {
                                        root.changed-fov(v);
                                    }
                                }

                                if !root.lens-preview-active: CheckBox {
                                    text: "Keep view inside coverage";
                                    checked <=> root.use-constrained-look;
                                    toggled => {
                                        root.changed-constrained-look();
                                    }
                                }

                                if !root.lens-preview-active: Button {
                                    text: "Reset view";
                                    clicked => {
                                        root.reset-view();
                                    }
                                }

                                // Stitching settings only appear after calibration is loaded

                        if root.files-loaded: Text {
                                    text: "Stitching";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                if root.files-loaded && root.is-l-shape: LabeledSlider {
                                    label: "Seam blend";
                                    minimum: 0;
                                    maximum: 0.3;
                                    value <=> root.blend-width;
                                    decimals: 2;
                                    changed(v) => {
                                        root.changed-blend-width(v);
                                    }
                                }

                                if root.files-loaded: LabeledSlider {
                                    label: "Rig tilt";
                                    minimum: -30;
                                    maximum: 30;
                                    value <=> root.rig-tilt;
                                    suffix: "°";
                                    decimals: 1;
                                    changed(v) => {
                                        root.changed-rig-tilt(v);
                                    }
                                }

                                if root.files-loaded: LabeledSlider {
                                    label: "Rig roll";
                                    minimum: -15;
                                    maximum: 15;
                                    value <=> root.rig-roll;
                                    suffix: "°";
                                    decimals: 1;
                                    changed(v) => {
                                        root.changed-rig-roll(v);
                                    }
                                }

                                if root.files-loaded && root.is-l-shape && !root.network-active: HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Sync offset";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    sync-input := LineEdit {
                                        text: root.sync-offset;
                                        width: 70px;
                                        accepted => {
                                            root.sync-offset = self.text.to-float();
                                            root.changed-sync-offset(self.text.to-float());
                                        }
                                    }

                                    Text {
                                        text: "frames";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Button {
                                        text: "Apply";
                                        clicked => {
                                            root.sync-offset = sync-input.text.to-float();
                                            root.changed-sync-offset(sync-input.text.to-float());
                                        }
                                    }
                                }

                                // ── Lens (collapsible: info always, sliders on demand) ──
                    if root.is-l-shape: VerticalLayout {
                                    spacing: 8px;
                                    lens-section := SectionHeader {
                                        title: root.lens-info-available ? "Lens - " + root.lens-left-camera : "Lens";
                                        expanded: false;
                                    }

                                    if lens-section.expanded && root.files-loaded: VerticalLayout {
                                        spacing: 6px;

                                        if root.lens-info-available: VerticalLayout {
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: "L";
                                                    color: Theme.accent;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    width: 14px;
                                                }

                                                Text {
                                                    text: root.lens-left-source + " - " + root.lens-left-camera;
                                                    color: Theme.text-body;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: "R";
                                                    color: Theme.accent;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    width: 14px;
                                                }

                                                Text {
                                                    text: root.lens-right-source + " - " + root.lens-right-camera;
                                                    color: Theme.text-body;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        if !root.lens-info-available: Text {
                                            text: "Auto-calibrate to detect lens.";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Button {
                                            text: "Browse profiles...";
                                            clicked => {
                                                root.lens-picker-open = true;
                                            }
                                        }

                                        Rectangle {
                                            height: 4px;
                                        }

                                        CheckBox {
                                            text: "Use distortion coefficients";
                                            checked: root.lens-correction-amount > 0.5;
                                            toggled => {
                                                root.lens-correction-amount = self.checked ? 1.0 : 0.0;
                                                root.changed-lens-correction(root.lens-correction-amount);
                                            }
                                        }

                                        CheckBox {
                                            text: "Lens preview (single camera)";
                                            checked <=> root.lens-preview-active;
                                            toggled => {
                                                root.changed-lens-preview();
                                            }
                                        }

                                        // Fine-tune: auto-expands in lens preview mode
                            lens-tune := SectionHeader {
                                            title: "Fine-tune";
                                            expanded: root.lens-preview-active;
                                        }

                                        if lens-tune.expanded: VerticalLayout {
                                            spacing: 4px;

                                            HorizontalLayout {
                                                spacing: 4px;
                                                Button {
                                                    text: "Left";
                                                    primary: root.lens-selected-camera == "left";
                                                    clicked => {
                                                        root.lens-selected-camera = "left";
                                                    }
                                                }

                                                Button {
                                                    text: "Right";
                                                    primary: root.lens-selected-camera == "right";
                                                    clicked => {
                                                        root.lens-selected-camera = "right";
                                                    }
                                                }

                                                Button {
                                                    text: "Both";
                                                    primary: root.lens-selected-camera == "both";
                                                    clicked => {
                                                        root.lens-selected-camera = "both";
                                                    }
                                                }
                                            }

                                            if root.lens-selected-camera == "left" || root.lens-selected-camera == "both": VerticalLayout {
                                                spacing: 3px;
                                                LabeledSlider {
                                                    label: "fx";
                                                    minimum: root.lens-fx-min;
                                                    maximum: root.lens-fx-max;
                                                    value <=> root.lens-left-fx;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "fy";
                                                    minimum: root.lens-fy-min;
                                                    maximum: root.lens-fy-max;
                                                    value <=> root.lens-left-fy;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "cx";
                                                    minimum: root.lens-cx-min;
                                                    maximum: root.lens-cx-max;
                                                    value <=> root.lens-left-cx;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "cy";
                                                    minimum: root.lens-cy-min;
                                                    maximum: root.lens-cy-max;
                                                    value <=> root.lens-left-cy;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k1";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-left-k1;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k2";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-left-k2;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k3";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-left-k3;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k4";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-left-k4;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }
                                            }

                                            if root.lens-selected-camera == "right": VerticalLayout {
                                                spacing: 3px;
                                                LabeledSlider {
                                                    label: "fx";
                                                    minimum: root.lens-fx-min;
                                                    maximum: root.lens-fx-max;
                                                    value <=> root.lens-right-fx;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "fy";
                                                    minimum: root.lens-fy-min;
                                                    maximum: root.lens-fy-max;
                                                    value <=> root.lens-right-fy;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "cx";
                                                    minimum: root.lens-cx-min;
                                                    maximum: root.lens-cx-max;
                                                    value <=> root.lens-right-cx;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "cy";
                                                    minimum: root.lens-cy-min;
                                                    maximum: root.lens-cy-max;
                                                    value <=> root.lens-right-cy;
                                                    decimals: 0;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k1";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-right-k1;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k2";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-right-k2;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k3";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-right-k3;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }

                                                LabeledSlider {
                                                    label: "k4";
                                                    minimum: -root.lens-k-range;
                                                    maximum: root.lens-k-range;
                                                    value <=> root.lens-right-k4;
                                                    decimals: 2;
                                                    changed(v) => {
                                                        root.changed-lens-param();
                                                    }
                                                }
                                            }

                                            Button {
                                                text: "Reset Lens";
                                                enabled: root.lens-dirty;
                                                clicked => {
                                                    root.reset-lens();
                                                }
                                            }
                                        }
                                    }
                                }

                                // ── Calibration (collapsible) ──
                    cal-section := SectionHeader {
                                    title: "Projection geometry";
                                    expanded: false;
                                }

                                if cal-section.expanded: VerticalLayout {
                                    spacing: 8px;

                                    if root.is-l-shape: LabeledSlider {
                                        label: "Plane intersection";
                                        minimum: -1.0;
                                        maximum: 1.0;
                                        value <=> root.cal-intersect;
                                        decimals: 3;
                                        changed(v) => {
                                            root.changed-cal-intersect(v);
                                        }
                                    }

                                    LabeledSlider {
                                        label: "Camera axis offset";
                                        minimum: -0.6;
                                        maximum: 0.6;
                                        value <=> root.cal-camera-axis-offset;
                                        decimals: 3;
                                        changed(v) => {
                                            root.changed-cal-camera-axis-offset(v);
                                        }
                                    }

                                    if root.is-l-shape: LabeledSlider {
                                        label: "Left plane Y offset";
                                        minimum: -0.1;
                                        maximum: 0.1;
                                        value <=> root.cal-x-ty;
                                        decimals: 3;
                                        changed(v) => {
                                            root.changed-cal-x-ty(v);
                                        }
                                    }

                                    Button {
                                        text: "Reset";
                                        enabled: root.cal-dirty;
                                        clicked => {
                                            root.reset-calibration();
                                        }
                                    }
                                }

                                recording-section := SectionHeader {
                                    title: "Quick recording";
                                    expanded: root.recording;
                                }

                                if recording-section.expanded: VerticalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: "Fixed-rate capture of the interactive view. Frames may be skipped; use Export to process the source timeline.";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        ComboBox {
                                            model: root.available-codecs;
                                            current-value <=> root.recording-codec;
                                            enabled: !root.recording;
                                            horizontal-stretch: 1;
                                        }

                                        ComboBox {
                                            model: ["fast", "balanced", "high"];
                                            current-value <=> root.recording-quality;
                                            enabled: !root.recording;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    Button {
                                        text: root.recording ? "Stop recording" : "Start recording";
                                        enabled: root.files-loaded && !root.network-active && !root.export-in-progress && !root.lens-preview-active && !root.field-editing;
                                        clicked => {
                                            root.toggle-recording(root.recording-codec, root.recording-quality);
                                        }
                                    }
                                }

                                // ── Stats (collapsible, hidden in lens preview) ──
                    if !root.lens-preview-active: VerticalLayout {
                                    spacing: 10px;

                                    stats-section := SectionHeader {
                                        title: root.export-in-progress ? "Export diagnostics" : "Last export";
                                        expanded: false;
                                    }

                                    if stats-section.expanded && root.telem-fps-avg <= 0: Text {
                                        text: "No export timing data.";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                    }
                                    if stats-section.expanded && root.telem-fps-avg > 0: VerticalLayout {
                                        spacing: 4px;

                                        Text {
                                            text: "FPS: " + round(root.telem-fps-avg) + " avg / " + round(root.telem-fps-recent) + " recent";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: "Host/frame: " + round(root.telem-total-ms * 10) / 10 + " / " + round(root.telem-p99-ms * 10) / 10 + " p99 ms";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: "  Decode:   " + round(root.telem-decode-ms * 10) / 10 + " ms";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: "  Stitch:   " + round(root.telem-stitch-ms * 10) / 10 + " ms";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: "  Readback: " + round(root.telem-readback-ms * 10) / 10 + " ms";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: "  Submit:   " + round(root.telem-submit-ms * 10) / 10 + " ms";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        if root.telem-gpu-name != "": Text {
                                            text: root.telem-gpu-name;
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Rectangle {
                                            height: 4px;
                                        }

                                        if root.telem-detection-ms > 0: Text {
                                            text: "Ball: " + round(root.telem-ball-pct) + "%  Tracks: " + root.telem-active-tracks + "  Det: " + round(root.telem-det-per-frame * 10) / 10 + "/f";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }
                                        if root.telem-detection-ms > 0: Text {
                                            text: "Detection: " + round(root.telem-detection-ms * 10) / 10 + " ms";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }
                                        if root.telem-tracking-ms > 0: Text {
                                            text: "Tracking: " + round(root.telem-tracking-ms * 10) / 10 + " ms";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }
                                        if root.telem-encode-ms > 0: Text {
                                            text: "Output worker: " + round(root.telem-encode-ms * 10) / 10 + " ms (overlapped)";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }
                                        if root.telem-backpressure-ms > 0: Text {
                                            text: "Backpressure: " + round(root.telem-backpressure-ms) + " ms total";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                        }
                                    }
                                }  // close stats wrapper (lens-preview gate)

                        }
                        }
                    }
                }
            }

            // ── Transport bar (single inline row) ──
        Rectangle {
                background: Theme.bg-base;
                height: 54px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 6px;

                    // Playback buttons
                if !root.network-active: Button {
                        text: "|‹";
                        description: "Previous frame";
                        enabled: root.files-loaded && !root.network-active;
                        clicked => {
                            root.step-backward();
                        }
                    }

                    Button {
                        text: root.network-active ? (root.playing ? "Pause preview" : "Resume preview") : (root.playing ? "Pause" : "Play");
                        description: root.network-active ? "Pause or resume the preview; live cameras keep capturing" : root.playing ? "Pause playback" : "Start playback";
                        enabled: root.files-loaded && !root.export-in-progress;
                        clicked => {
                            root.toggle-playback();
                        }
                    }

                    if !root.network-active: Button {
                        text: "›|";
                        description: "Next frame";
                        enabled: root.files-loaded && !root.network-active;
                        clicked => {
                            root.step-forward();
                        }
                    }

                    if !root.network-active: Text {
                        text: root.current-time-text;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 44px;
                        horizontal-alignment: right;
                    }

                    if !root.network-active: Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;

                        // Export range indicator (green tint behind the slider)
                    if root.files-loaded && (root.export-start-secs > 0 || root.export-end-secs < root.clip-duration-secs): Rectangle {
                            property <float> start-frac: root.clip-duration-secs > 0 ? root.export-start-secs / root.clip-duration-secs : 0;
                            property <float> end-frac: root.clip-duration-secs > 0 ? root.export-end-secs / root.clip-duration-secs : 1.0;

                            x: parent.width * start-frac;
                            width: parent.width * (end-frac - start-frac);
                            height: parent.height;
                            background: #4a7a4a33;
                            border-radius: 2px;
                        }

                        Slider {
                            width: 100%;
                            minimum: 1;
                            maximum: root.total-frames == 0 ? 1.0 : 1.0 * root.total-frames;
                            value: 1.0 * root.current-frame;
                            enabled: root.files-loaded && !root.network-active;
                            released(val) => {
                                if root.total-frames > 0 {
                                    root.seek-frame(round(val) - 1);
                                }
                            }
                        }
                    }

                    if !root.network-active: Text {
                        text: root.total-time-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 44px;
                    }
                    if root.network-active: Text {
                        text: root.export-in-progress ? "Preview paused during output" : root.files-loaded ? "Live · " + round(root.fps * 100) / 100 + " fps" : "Preview stopped";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.recording: Button {
                        text: "Stop recording";
                        clicked => {
                            root.toggle-recording(root.recording-codec, root.recording-quality);
                        }
                    }
                    Text {
                        text: "Aspect";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    ComboBox {
                        model: ["auto", "16:9", "4:3", "21:9"];
                        current-value <=> root.preview-aspect;
                        enabled: root.files-loaded;
                        width: 78px;
                        selected(v) => {
                            root.changed-preview-aspect(v);
                        }
                    }
                }
            }

            // ── Status bar (or export progress when active) ──
        Rectangle {
                background: Theme.bg-base;
                min-height: 28px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                    if !root.export-in-progress: Text {
                        text: root.status-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    // Keep the full status message readable on narrow windows.
                    wrap: word-wrap;
                        horizontal-stretch: 1;
                    }

                    if root.export-in-progress: Text {
                        text: (root.network-active ? "Live output: " : "Exporting: ") + root.export-status-text;
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        font-weight: 600;
                    }

                    if root.export-stream-status != "": Text {
                        text: root.export-stream-status;
                        color: root.export-stream-failed ? Theme.accent-error : Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    }

                    if root.export-in-progress: ProgressIndicator {
                        progress: root.export-progress;
                        indeterminate: root.network-active;
                        min-width: 120px;
                        horizontal-stretch: 1;
                    }

                    if root.export-in-progress: Button {
                        text: root.network-active ? "Stop and save" : "Cancel";
                        clicked => {
                            root.cancel-export();
                        }
                    }

                    if !root.export-in-progress && root.last-output-path != "": Button {
                        text: "Show in folder";
                        clicked => {
                            root.show-in-folder(root.last-output-path);
                        }
                    }

                    Button {
                        text: "Report bug";
                        quiet: true;
                        clicked => {
                            root.bug-dialog-open = true;
                        }
                    }
                }
            }
        }  // close VerticalBox

    }  // close FocusScope key-scope

    // ── Toast stack (floating overlay, bottom-right) ──
    // Placed as a direct child of the Window (outside FocusScope and
    // VerticalLayout) so it overlays everything without affecting layout.
    if !root.modal-open: ToastStack {
        toasts: root.toasts;
        right-inset: root.inspector-open ? root.inspector-width + 12px : 0px;
        dismissed(id) => {
            root.toast-dismissed(id);
        }
    }

    // The toolkit confines focus and restores it when the dialog closes.
    modal := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;
        forward-focus: dialog-keys;

        Rectangle {
            background: Theme.bg-scrim;
            TouchArea {
                clicked => {
                    if !root.file-dialog-open {
                        root.dismiss-dialogs();
                    }
                }
            }
        }

        dialog-keys := FocusScope {
            width: 100%;
            height: 100%;
            capture-key-pressed(event) => {
                if root.file-dialog-open {
                    return accept;
                }
                if event.text == Key.Escape {
                    root.dismiss-dialogs();
                    return accept;
                }
                return reject;
            }
        // ── Recent files dialog ──
        if root.recent-dialog-open: Rectangle {

                Rectangle {
                    width: min(720px, root.width - 32px);
                    height: min(460px, root.height - 32px);
                    background: Theme.bg-surface;
                    border-radius: 12px;
                // Block click-through so clicks inside the panel do
                // not close the dialog.
                TouchArea { }

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Recent files";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 600;
                            }

                            Button {
                                text: "Clear all";
                                clicked => {
                                    root.clear-recent-files();
                                    root.recent-dialog-open = false;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            padding: 0;
                            vertical-stretch: 1;

                            // Three column wrappers share the same structure
                        // so the styling stays consistent.
                        Rectangle {
                                border-radius: 6px;
                                background: Theme.bg-panel;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text {
                                        text: "Left videos";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 2px;
                                            for entry in root.recent-left-paths: Rectangle {
                                                height: 28px;
                                                border-radius: 4px;
                                                background: row-l.has-hover ? Theme.bg-hover : transparent;
                                                Text {
                                                    text: entry;
                                                    color: Theme.text-body;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                }

                                                row-l := TouchArea {
                                                    clicked => {
                                                        root.load-recent-left(entry);
                                                        root.recent-dialog-open = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 6px;
                                background: Theme.bg-panel;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text {
                                        text: "Right videos";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 2px;
                                            for entry in root.recent-right-paths: Rectangle {
                                                height: 28px;
                                                border-radius: 4px;
                                                background: row-r.has-hover ? Theme.bg-hover : transparent;
                                                Text {
                                                    text: entry;
                                                    color: Theme.text-body;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                }

                                                row-r := TouchArea {
                                                    clicked => {
                                                        root.load-recent-right(entry);
                                                        root.recent-dialog-open = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 6px;
                                background: Theme.bg-panel;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text {
                                        text: "Calibrations";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 2px;
                                            for entry in root.recent-calibration-paths: Rectangle {
                                                height: 28px;
                                                border-radius: 4px;
                                                background: row-c.has-hover ? Theme.bg-hover : transparent;
                                                Text {
                                                    text: entry;
                                                    color: Theme.text-body;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                }

                                                row-c := TouchArea {
                                                    clicked => {
                                                        root.load-recent-calibration(entry);
                                                        root.recent-dialog-open = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "Close";
                                clicked => {
                                    root.recent-dialog-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // ── Keyboard shortcuts dialog (modal) ──
        if root.shortcuts-dialog-open: Rectangle {

                Rectangle {
                    width: 420px;
                    height: 400px;
                    background: Theme.bg-surface;
                    border-radius: 12px;
                    TouchArea { }

                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;

                        Text {
                            text: "Keyboard shortcuts";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        Text {
                            text: "Reco " + root.version;
                            color: Theme.text-muted;
                            font-size: 12px;
                        }

                        // Explicit two-column rows for alignment: the key
                    // column is fixed width, the description fills.
                    for row in [
                            { k: "Space", v: "Play / pause" },
                            { k: "Arrows", v: "Pan camera" },
                            { k: "+  /  -", v: "Zoom in / out" },
                            { k: "Scroll", v: "Zoom in / out" },
                            { k: "Drag", v: "Pan preview with mouse" },
                            { k: "[  /  ]", v: "Seek backward / forward 5 seconds" },
                            { k: "R", v: "Reset camera view (yaw, pitch, FOV)" },
                            { k: "F / F11", v: "Toggle fullscreen" },
                            { k: "Escape", v: "Close the current dialog" },
                        ]: HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: row.k;
                                color: Theme.accent;
                                font-size: 12px;
                                font-weight: 600;
                                width: 80px;
                            }

                            Text {
                                text: row.v;
                                color: Theme.text-body;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Website";
                                clicked => {
                                    root.open-website();
                                }
                            }

                            Button {
                                text: "Forum";
                                clicked => {
                                    root.open-forum();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: "Close";
                                clicked => {
                                    root.shortcuts-dialog-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // ── Preferences dialog (modal) ──
        //
        // Editable subset of GuiSettings: default export codec,
        // default quality, default blend width, AI model path. Save
        // persists; Cancel discards.
        if root.prefs-dialog-open: Rectangle {

                Rectangle {
                    width: 480px;
                    height: min(parent.height - 60px, 680px);
                    background: Theme.bg-surface;
                    border-radius: 12px;
                    TouchArea { }

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        Text {
                            text: "Preferences";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;

                                Text {
                                    text: "Default codec";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                ComboBox {
                                    model: root.available-codecs;
                                    current-value <=> root.prefs-default-codec;
                                }

                                Text {
                                    text: "Default quality";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                ComboBox {
                                    model: ["fast", "balanced", "high"];
                                    current-value <=> root.prefs-default-quality;
                                }

                                Text {
                                    text: "Default seam blend (" + round(root.prefs-default-blend-width * 100) / 100 + ")";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                Slider {
                                    minimum: 0;
                                    maximum: 0.3;
                                    value <=> root.prefs-default-blend-width;
                                }

                                Text {
                                    text: "AI model (ONNX)";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.prefs-ai-model-path;
                                        placeholder-text: "Path to .onnx, or leave empty";
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Browse…";
                                        clicked => {
                                            root.pick-prefs-model();
                                        }
                                    }
                                }

                                Text {
                                    text: "Recording defaults";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Codec";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        ComboBox {
                                            model: root.available-codecs;
                                            current-value <=> root.prefs-recording-codec;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Quality";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        ComboBox {
                                            model: ["fast", "balanced", "high"];
                                            current-value <=> root.prefs-recording-quality;
                                        }
                                    }
                                }

                                Text {
                                    text: "Recording folder";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.prefs-recording-folder;
                                        placeholder-text: "Same as source video (default)";
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Browse…";
                                        clicked => {
                                            root.pick-recording-folder();
                                        }
                                    }
                                }

                                Text {
                                    text: "Appearance";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                CheckBox {
                                    text: "Dark mode";
                                    checked <=> root.prefs-dark-mode;
                                }

                                Text {
                                    text: "Privacy";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                CheckBox {
                                    text: "Send anonymous usage data (opt-in)";
                                    checked <=> root.prefs-telemetry-enabled;
                                }

                                Text {
                                    text: "Helps improve Reco. Shares system info and performance data.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                clicked => {
                                    root.prefs-dialog-open = false;
                                }
                            }

                            Button {
                                text: "Save";
                                primary: true;
                                clicked => {
                                    root.save-prefs();
                                    root.prefs-dialog-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // ── Bug report dialog ──
        if root.bug-dialog-open: Rectangle {

                Rectangle {
                    width: 500px;
                    height: min(parent.height - 60px, 420px);
                    background: Theme.bg-surface;
                    border-radius: 12px;
                    TouchArea { }

                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        Text {
                            text: "Report a Bug";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                        }

                        Text {
                            text: "Tell us what happened. Your system info (GPU, OS, settings) will be included to help us fix the issue faster.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "What went wrong?";
                            color: Theme.text-body;
                            font-size: 12px;
                        }

                        bug-msg := LineEdit {
                            placeholder-text: "e.g. The video freezes when I click Export";
                        }

                        Text {
                            text: "How can we reach you? (optional)";
                            color: Theme.text-body;
                            font-size: 12px;
                        }

                        bug-contact := LineEdit {
                            text <=> root.bug-user-contact;
                            placeholder-text: "Forum username or email";
                        }

                        bug-share-logs := CheckBox {
                            text: "Include system info and logs";
                            checked: true;
                        }

                        Text {
                            text: "Shares GPU model, OS, performance stats, and logs. No video content is sent.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Cancel";
                                clicked => {
                                    root.bug-dialog-open = false;
                                }
                            }

                            Button {
                                text: "Send Report";
                                primary: true;
                                enabled: bug-msg.text != "";
                                clicked => {
                                    root.submit-bug-report(bug-msg.text, bug-contact.text, bug-share-logs.checked);
                                    root.bug-dialog-open = false;
                                }
                            }
                        }
                    }
                }
            }

        if root.network-dialog-open: Rectangle {
            Rectangle {
                width: 560px;
                height: min(parent.height - 60px, 620px);
                background: Theme.bg-surface;
                border-radius: 12px;
                TouchArea { }
                VerticalLayout {
                    padding: 24px; spacing: 14px;
                    Text { text: "Live RTSP inputs"; color: Theme.text-primary; font-size: 18px; font-weight: 600; }
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Use the loaded rig calibration. Camera timestamps must share a clock, or have measured offsets. Reco does not synchronize them from arrival time.";
                                wrap: word-wrap; color: Theme.text-muted; font-size: 12px;
                            }
                            if root.network-inputs.length == 0: Button {
                                text: "Load calibration…";
                                primary: true;
                                clicked => { root.network-dialog-open = false; root.pick-calibration(); }
                            }
                            for row[index] in root.network-inputs: VerticalLayout {
                                spacing: 4px;
                                Text { text: "Camera " + (index + 1); color: Theme.text-primary; font-size: 12px; }
                                LineEdit { text: row.url; edited(value) => { root.network-inputs[index] = {url: value, offset: row.offset}; } input-type: password; placeholder-text: "rtsp://host:port/camera"; enabled: !root.network-opening; }
                                LineEdit { text: row.offset; edited(value) => { root.network-inputs[index] = {url: row.url, offset: value}; } placeholder-text: "Timestamp offset in µs (0 if aligned)"; enabled: !root.network-opening; }
                            }
                            Text { text: "Output frame rate"; color: Theme.text-primary; font-size: 12px; }
                            LineEdit { text <=> root.network-fps; placeholder-text: "30 or 30000/1001"; enabled: !root.network-opening; }
                            Text {
                                text: "TCP transport · host-backed images · wait up to 150 ms · match within 30 ms · reuse up to 350 ms · 4 queued frames per camera. Stops on stale input or a changed clock. URLs stay in this session.";
                                wrap: word-wrap; color: Theme.text-muted; font-size: 12px;
                            }
                            Text { text: root.network-message; wrap: word-wrap; color: Theme.accent-warn; font-size: 12px; }
                        }
                    }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        Button { text: root.network-opening ? "Cancel connection" : "Close"; clicked => { if root.network-opening { root.cancel-network(); } else { root.network-dialog-open = false; } } }
                        Button { text: "Connect"; primary: true; enabled: !root.network-opening && root.network-inputs.length > 0; clicked => { root.connect-network(); } }
                    }
                }
            }
        }

            // ── Export dialog ──
        if root.export-dialog-open: Rectangle {

                Rectangle {
                    width: 560px;
                    height: min(parent.height - 60px, 720px);
                    background: Theme.bg-surface;
                    border-radius: 12px;

                    TouchArea { }

                    VerticalBox {
                        padding: 24px;
                        spacing: 14px;

                        Text {
                            text: root.network-active ? "Record / publish live video" : "Export Stitched Video";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                        }

                        ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 14px;

                                Text {
                                    text: root.network-active ? "Record the processed live feed until you stop it. Preview pauses while this job runs; AI tracking uses the settings below. Reconnect explicitly to preview again afterward." : "Save a stitched video from the source timeline.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                // Output path
                    Text {
                                    text: "Output file";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                HorizontalBox {
                                    spacing: 6px;
                                    padding: 0;
                        // Editable: users want to rename the suggested
                        // file without invoking the file dialog every
                        // time. Rust reads `export-output-path` verbatim
                        // when Start Export fires, so whatever is typed
                        // here is what gets written.
                        LineEdit {
                                        text <=> root.export-output-path;
                                        placeholder-text: "Pick a destination file, or type a path…";
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Save to…";
                                        clicked => {
                                            root.pick-export-output();
                                        }
                                    }
                                }

                                CheckBox {
                                    text: "Also stream to RTMP / RTMPS";
                                    checked <=> root.export-stream-enabled;
                                    toggled => { if self.checked { root.export-codec = "h264"; } }
                                }

                                if root.export-stream-enabled: VerticalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.export-stream-url;
                                        input-type: password;
                                        placeholder-text: "Complete publishing URL, including stream key";
                                    }
                                    Text {
                                        text: "Shares the H.264 recording at playback speed. A stream failure does not stop recording. The URL stays only in this session.";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Source audio"; color: Theme.text-body; vertical-alignment: center; }
                                    ComboBox {
                                        model: root.export-audio-options;
                                        current-index <=> root.export-audio-choice;
                                        horizontal-stretch: 1;
                                    }
                                }
                                if root.export-stream-enabled: Text {
                                    text: "Copies available AAC / MP3. Without source audio, the stream carries silence.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                // Resolution presets
                    HorizontalBox {
                                    spacing: 10px;
                                    padding: 0;

                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Resolution";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        ComboBox {
                                            model: ["1080p (1920x1080)", "720p (1280x720)", "2K (2560x1440)", "4K (3840x2160)"];
                                            current-index: root.export-width == 1280 ? 1 : root.export-width == 2560 ? 2 : root.export-width == 3840 ? 3 : 0;
                                            selected(v) => {
                                                if (v == "720p (1280x720)") {
                                                    root.export-width = 1280;
                                                    root.export-height = 720;
                                                } else if (v == "2K (2560x1440)") {
                                                    root.export-width = 2560;
                                                    root.export-height = 1440;
                                                } else if (v == "4K (3840x2160)") {
                                                    root.export-width = 3840;
                                                    root.export-height = 2160;
                                                } else {
                                                    root.export-width = 1920;
                                                    root.export-height = 1080;
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: root.export-width + " x " + root.export-height;
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                HorizontalBox {
                                    spacing: 10px;
                                    padding: 0;

                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Codec";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        ComboBox {
                                            model: root.available-codecs;
                                            enabled: !root.export-stream-enabled;
                                            current-index: root.export-codec == "hevc" ? 1 : root.export-codec == "av1" ? 2 : 0;
                                            selected(v) => {
                                                root.export-codec = v;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Quality";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        ComboBox {
                                            model: ["fast", "balanced", "high"];
                                            current-index: root.export-quality == "fast" ? 0 : root.export-quality == "high" ? 2 : 1;
                                            selected(v) => {
                                                root.export-quality = v;
                                            }
                                        }
                                    }
                                }

                                // Processing range (start/end with sliders and manual input)
                    if !root.network-active: Text {
                                    text: "Processing range";
                                    color: Theme.text-body;
                                    font-size: 12px;
                                }

                                if !root.network-active: HorizontalBox {
                                    spacing: 8px;
                                    padding: 0;

                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Start (s)";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Slider {
                                            minimum: 0;
                                            maximum: max(1, root.clip-duration-secs);
                                            value <=> root.export-start-secs;
                                            enabled: root.clip-duration-secs > 0;
                                            changed(v) => {
                                                if v > root.export-end-secs {
                                                    root.export-start-secs = root.export-end-secs;
                                                }
                                            }
                                        }

                                        LineEdit {
                                            text: root.export-start-secs == 0 ? "" : root.export-start-secs;
                                            placeholder-text: "0:00";
                                            edited(v) => {
                                                root.export-start-secs = Math.min(max(0, v.to-float()), root.export-end-secs);
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "End (s)";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }

                                        Slider {
                                            minimum: 0;
                                            maximum: max(1, root.clip-duration-secs);
                                            value <=> root.export-end-secs;
                                            enabled: root.clip-duration-secs > 0;
                                            changed(v) => {
                                                if v < root.export-start-secs {
                                                    root.export-end-secs = root.export-start-secs;
                                                }
                                            }
                                        }

                                        LineEdit {
                                            text: root.export-end-secs;
                                            placeholder-text: "";
                                            edited(v) => {
                                                root.export-end-secs = Math.max(Math.min(v.to-float(), root.clip-duration-secs), root.export-start-secs);
                                            }
                                        }
                                    }
                                }

                                if !root.network-active: Text {
                                    property <float> range-dur: root.export-end-secs - root.export-start-secs;
                                    text: range-dur <= 0 ? "Duration: 0s (nothing to export)" : "Duration: " + round(range-dur * 10) / 10 + "s";
                                    color: range-dur <= 0 ? Theme.accent-error : Theme.text-muted;
                                    font-size: 12px;
                                }

                                if root.is-l-shape: CheckBox {
                                    text: "Record replay (stacked raw input for re-stitching)";
                                    checked <=> root.export-replay-enabled;
                                }

                                CheckBox {
                                    text: "Save AI debug events (.jsonl for visualize_detections.py)";
                                    checked <=> root.export-events-enabled;
                                }

                                // AI Tracking section
                    HorizontalBox {
                                    padding: 0;
                                    spacing: 8px;
                                    Text {
                                        text: "AI Tracking";
                                        color: Theme.text-primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    CheckBox {
                                        text: "Enable";
                                        checked <=> root.export-autocam-enabled;
                                        enabled: root.ai-available;
                                    }
                                }

                                Text {
                                    text: root.ai-status;
                                    color: root.ai-available ? Theme.accent : Theme.accent-error;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                if root.export-autocam-enabled: VerticalLayout {
                                    spacing: 8px;

                                    HorizontalBox {
                                        spacing: 6px;
                                        padding: 0;
                                        LineEdit {
                                            text: root.export-model-path;
                                            placeholder-text: "Pick a YOLO ONNX model…";
                                            read-only: true;
                                            horizontal-stretch: 1;
                                        }

                                        Button {
                                            text: "Model…";
                                            clicked => {
                                                root.pick-export-model();
                                            }
                                        }
                                    }

                                    // AI is enabled but no model picked: without one the
                        // detector never attaches and the export silently
                        // produces no tracking. Warn and block Start below.
                        if root.export-model-path == "": Text {
                                        text: "⚠ Pick a model - AI tracking needs one, and export is blocked until you do.";
                                        color: Theme.accent-warn;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalBox {
                                        spacing: 10px;
                                        padding: 0;

                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Tracking mode";
                                                color: Theme.text-body;
                                                font-size: 12px;
                                            }

                                            ComboBox {
                                                model: ["field", "ball", "sweep"];
                                                current-index: root.export-tracking-mode == "ball" ? 1 : root.export-tracking-mode == "sweep" ? 2 : 0;
                                                selected(v) => {
                                                    root.export-tracking-mode = v;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Detect every N frames";
                                                color: Theme.text-body;
                                                font-size: 12px;
                                            }

                                            ComboBox {
                                                model: ["1", "3", "5", "10", "15", "30"];
                                                current-index: root.export-detection-interval == 1 ? 0 : root.export-detection-interval == 5 ? 2 : root.export-detection-interval == 10 ? 3 : root.export-detection-interval == 15 ? 4 : root.export-detection-interval == 30 ? 5 : 1;
                                                selected(v) => {
                                                    root.export-detection-interval = v == "1" ? 1 : v == "5" ? 5 : v == "10" ? 10 : v == "15" ? 15 : v == "30" ? 30 : 3;
                                                }
                                            }
                                        }
                                    }

                                    // Style preset: sets the controls below; tweak after.
                        VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: "Style preset";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        ComboBox {
                                            model: ["broadcast", "action", "frame_all"];
                                            current-index: root.export-panner-preset == "action" ? 1 : root.export-panner-preset == "frame_all" ? 2 : 0;
                                            selected(v) => {
                                                root.export-panner-preset = v;
                                                root.apply-panner-preset(v);
                                            }
                                        }
                                    }

                                    // Framing + pitch lock.
                        HorizontalBox {
                                        spacing: 10px;
                                        padding: 0;

                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Framing";
                                                color: Theme.text-body;
                                                font-size: 12px;
                                            }

                                            ComboBox {
                                                model: ["action", "frame_all"];
                                                current-index: root.export-framing == "frame_all" ? 1 : 0;
                                                selected(v) => {
                                                    root.export-framing = v;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Pitch";
                                                color: Theme.text-body;
                                                font-size: 12px;
                                            }

                                            CheckBox {
                                                text: "Lock (horizontal-only)";
                                                checked <=> root.export-lock-pitch;
                                            }
                                        }
                                    }

                                    // Zero disables lookahead. Export validates the image budget.
                        LabeledSlider {
                                        label: "Lookahead (smoothness)";
                                        minimum: 0.0;
                                        maximum: 2.5;
                                        value <=> root.export-lookahead-secs;
                                        suffix: "s";
                                        decimals: 1;
                                    }

                                    panner-advanced := SectionHeader {
                                        title: "Advanced panner";
                                        expanded: false;
                                    }

                                    if panner-advanced.expanded: VerticalLayout {
                                        spacing: 8px;

                                        HorizontalBox {
                                            spacing: 10px;
                                            padding: 0;

                                            VerticalLayout {
                                                spacing: 4px;
                                                horizontal-stretch: 1;
                                                Text {
                                                    text: "Cluster mode";
                                                    color: Theme.text-body;
                                                    font-size: 12px;
                                                }

                                                ComboBox {
                                                    model: ["density", "trimmed_mean"];
                                                    current-index: root.export-cluster-mode == "trimmed_mean" ? 1 : 0;
                                                    selected(v) => {
                                                        root.export-cluster-mode = v;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                spacing: 4px;
                                                horizontal-stretch: 1;
                                                LabeledSlider {
                                                    label: "Ball weight";
                                                    minimum: 0.0;
                                                    maximum: 1.0;
                                                    value <=> root.export-ball-weight;
                                                    decimals: 2;
                                                }
                                            }
                                        }

                                        LabeledSlider {
                                            label: "Cluster bandwidth";
                                            minimum: 0.1;
                                            maximum: 0.6;
                                            value <=> root.export-cluster-bandwidth;
                                            suffix: " rad";
                                            decimals: 2;
                                        }

                                        LabeledSlider {
                                            label: "Dead-zone";
                                            minimum: 0.0;
                                            maximum: 0.5;
                                            value <=> root.export-dead-zone;
                                            suffix: " rad";
                                            decimals: 2;
                                        }

                                        Text {
                                            text: "Field of view (degrees)";
                                            color: Theme.text-body;
                                            font-size: 12px;
                                        }

                                        HorizontalBox {
                                            spacing: 10px;
                                            padding: 0;
                                            LabeledSlider {
                                                label: "Tight";
                                                minimum: root.export-framing == "frame_all" ? 0.0 : 10.0;
                                                maximum: root.export-framing == "frame_all" ? 180.0 : 40.0;
                                                value <=> root.export-fov-tight;
                                                decimals: 0;
                                            }

                                            LabeledSlider {
                                                label: "Default";
                                                minimum: 20.0;
                                                maximum: 60.0;
                                                value <=> root.export-fov-default;
                                                decimals: 0;
                                            }

                                            LabeledSlider {
                                                label: "Wide";
                                                minimum: root.export-framing == "frame_all" ? 0.0 : 40.0;
                                                maximum: root.export-framing == "frame_all" ? 180.0 : 90.0;
                                                value <=> root.export-fov-wide;
                                                decimals: 0;
                                            }
                                        }

                                        if root.export-framing == "frame_all": LabeledSlider {
                                            label: "Margin";
                                            minimum: 0.0;
                                            maximum: 20.0;
                                            value <=> root.export-frame-all-margin;
                                            decimals: 0;
                                        }
                                    }
                                }
                            }
                        }

                        if root.export-error-text != "": Text {
                            text: root.export-error-text;
                            color: Theme.accent-error;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            padding: 0;

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: "Cancel";
                                clicked => {
                                    root.export-dialog-open = false;
                                    root.export-error-text = "";
                                }
                            }

                            Button {
                                text: root.network-active ? (root.export-stream-enabled ? "Record and stream" : "Start recording") : (root.export-stream-enabled ? "Export and stream" : "Start export");
                                primary: true;
                            // Block when AI tracking is on but no model is
                            // picked - otherwise the export runs with no
                            // tracking and no warning.
                            enabled: root.export-output-path != "" && !(root.export-stream-enabled && root.export-stream-url == "") && !(root.export-autocam-enabled && root.export-model-path == "");
                                clicked => {
                                    root.start-export();
                                }
                            }
                        }
                    }
                }
            }
        // ── Lens profile picker dialog (modal) ──
        if root.lens-picker-open: Rectangle {

                Rectangle {
                    width: 520px;
                    height: min(parent.height - 80px, 540px);
                    background: Theme.bg-surface;
                    border-radius: 12px;
                    TouchArea { }

                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "Browse Lens Profiles";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Apply to:";
                                color: Theme.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            ComboBox {
                                model: ["Both", "Left", "Right"];
                                current-value: root.lens-pick-side == "left" ? "Left" : root.lens-pick-side == "right" ? "Right" : "Both";
                                width: 80px;
                                selected(v) => {
                                    root.lens-pick-side = v == "Left" ? "left" : v == "Right" ? "right" : "both";
                                }
                            }
                        }

                        LineEdit {
                            text <=> root.lens-search-query;
                            placeholder-text: "Search by camera, lens, resolution...";
                            edited(text) => {
                                root.lens-search-changed(text);
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 2px;

                                if root.lens-search-results.length == 0 && root.lens-search-query != "": Text {
                                    text: "No profiles match your search.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }

                                if root.lens-search-query == "": Text {
                                    text: "Type to search across 4200+ camera profiles.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }

                                for result[idx] in root.lens-search-results: Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: lens-row.has-hover ? Theme.bg-hover : Theme.bg-card;

                                    lens-row := TouchArea {
                                        clicked => {
                                            root.lens-pick(idx, root.lens-pick-side);
                                            root.lens-picker-open = false;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: result;
                                            color: Theme.text-body;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Load from file...";
                                clicked => {
                                    root.lens-pick-file();
                                }
                            }

                            Button {
                                text: "Close";
                                clicked => {
                                    root.lens-picker-open = false;
                                }
                            }
                        }
                    }
                }
            }

            ToastStack {
                toasts: root.toasts;
                dismissed(id) => {
                    root.toast-dismissed(id);
                }
            }

            // Native picker completion and worker disconnect both release this guard.
    if root.file-dialog-open: Rectangle {
                TouchArea { }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: guard-label.preferred-width + 40px;
                    height: guard-label.preferred-height + 28px;
                    background: Theme.bg-card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-mid;
                    guard-label := Text {
                        text: "Finish in the file picker window…";
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        font-size: 14px;
                    }
                }
            }
        }
    }
}
